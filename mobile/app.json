{
  "expo": {
    "name": "VEDA",
    "slug": "veda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "veda",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.veda.app",
      "infoPlist": {
        "NSCameraUsageDescription": "VEDA needs camera access to scan product labels, barcodes, and pills",
        "NSPhotoLibraryUsageDescription": "VEDA needs photo library access to analyze product labels"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.veda.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "VEDA needs photo access to analyze product labels"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
